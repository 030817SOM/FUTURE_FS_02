generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique @db.Citext
  passwordHash String
  displayName  String
  avatarUrl    String?
  role         Role     @default(agent)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  leads        Lead[]
  notes        LeadNote[]
}

enum Role {
  admin
  agent
}

model Lead {
  id          String    @id @default(uuid())
  ownerId     String?   @db.Uuid
  owner       User?     @relation(fields: [ownerId], references: [id])
  name        String
  email       String
  phone       String?
  company     String?
  source      String
  status      LeadStatus @default(new)
  message     String?
  followUpAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  notes       LeadNote[]
}

enum LeadStatus {
  new
  contacted
  converted
  lost
}

model LeadNote {
  id        String   @id @default(uuid())
  leadId    String   @db.Uuid
  lead      Lead     @relation(fields: [leadId], references: [id])
  authorId  String?  @db.Uuid
  author    String?
  body      String
  createdAt DateTime @default(now())
}